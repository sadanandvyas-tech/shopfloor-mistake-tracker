# Local dev only — production VPS .env should NOT include PORT.
# (PORT is read by local.js, never by server.js.)
PORT=3001

# Postgres connection. In local dev, point at your Mac's Postgres.
# In production on the VPS, this becomes:
#   postgres://fivesuser:<password>@localhost:5432/shopfloor_mistake_tracker
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopfloor_mistake_tracker

# Optional: override the upstream Projects Table API URL (Pattern A proxy).
# Default falls back to http://localhost:3010/projects/api/work-orders, which
# is correct in production. In local dev (without the projects-table app
# running), the typeahead will gracefully degrade to free-text input.
# PROJECTS_API_URL=
